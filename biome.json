{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.pki",
			"!.demo",
			"!.claude",
			"!site/.next",
			"!site/out"
		]
	}
}
