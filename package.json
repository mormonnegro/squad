{
	"name": "squad",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"console": "VITE_SQUAD_HOSTED=1 pnpm --filter @squad/web build",
		"site": "pnpm run console && pnpm --filter @squad/site build && cp -R packages/web/dist site/out/app"
	},
	"devDependencies": {
		"@squad/control-plane": "workspace:*",
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
