# Copy to .env. These are the values behind the names in config.yaml; the file names them, the
# process holds them.

# The key the agent's own turns run on. Resolved by the proxy, not passed into the sandbox: the
# agent's requests to the model leave it without a key and get one on the way out.
DEEPSEEK_API_KEY=

# The other two models config.example.yaml lists, and the key the `search` grant is scoped to.
# Every one of these may be left empty: a model whose key this plane does not hold is refused at
# the proxy until it does, and the setup screen in `agent` is where it is given without a redeploy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Resolved by the proxy for a grant's `ref`. The agent never sees it.
GITHUB_TOKEN=

# Verifies the signature on POST /hooks/deploys, and signs replies back to replyUrl.
DEPLOY_HOOK_SECRET=
