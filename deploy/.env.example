# Copy to .env. These are the values behind the names in config.yaml; the file names them, the
# process holds them.

# The key the agent's own turns run on, passed into the sandbox.
ANTHROPIC_API_KEY=

# Resolved by the proxy for a grant's `ref`. The agent never sees it.
GITHUB_TOKEN=

# Verifies the signature on POST /hooks/deploys, and signs replies back to replyUrl.
DEPLOY_HOOK_SECRET=
